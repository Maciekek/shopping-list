# ---- deploy/.env : copy to deploy/.env and fill in ----

# connection_limit keeps Prisma's pool small on a shared server
DATABASE_URL=postgresql://USER:PASSWORD@psql.mikr.us:5432/USER?connection_limit=3

# Public domain, DNS A record must point at the VPS. vps-proxy routes it here and gets the cert.
DOMAIN=shopylist.pl
# Public app URL (auth callbacks, share links), must match DOMAIN
NEXTAUTH_URL=https://shopylist.pl
AUTH_TRUST_HOST=true

# Generate: openssl rand -base64 32
AUTH_SECRET=replace-with-random-secret

# Google OAuth (add https://shopylist.pl/api/auth/callback/google as redirect URI)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: share-list emails via SMTP (Brevo relay, same account as my-pi-home)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# must be a sender verified in Brevo (single address or domain)
SMTP_FROM=hello@shopylist.pl

# Optional: LLM sorting of list items
GEMINI_API_KEY=

# Optional: image tag to run (latest or a commit sha)
SHOPPING_LIST_TAG=latest
